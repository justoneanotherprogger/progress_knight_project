{
	"$schema": "https://biomejs.dev/schemas/2.5.14/schema.json",
	"vcs": {
		"enabled": true,
		"clientKind": "git",
		"useIgnoreFile": true
	},
	"files": {
		"includes": ["**/*.js", "!**/node_modules", "!**/vendor"]
	},
	"linter": {
		"rules": {
			"correctness": {
				"noUnusedVariables": "off"
			}
		}
	}
}
